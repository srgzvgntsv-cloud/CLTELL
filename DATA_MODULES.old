module CONSTANTS
 real(8), parameter :: cvel   = 2.997925d5         ! in km/s
 real(8), parameter :: vellgt = 2.99792458E+10     ! in cm/s
 real(8), parameter :: const1 = 1.073605687971E+04 ! sqrt(2.0*log(2.0)*boltz*avogno)
 real(8), parameter :: cl2    = 1.43877736E0
 real(8), parameter :: Na     = 6.022169E+23       ! Number Avogadro
 real(8), parameter :: rgas   = 8314.32E0
 real(8), parameter :: Tref   = 296.E0             ! Reference T, K
 real(8), parameter :: Pref   = 1.01325E5          ! Reference P, bar
 real(8), parameter :: Vm     = 22.413962E0
 real(8), parameter :: N0     = (Na/Vm)/1.E3
 real(8), parameter :: M0     = 28.9644E0
 real(8)            :: meanmass(9)
 data (meanmass(n),n=1,9)/18.010565, 43.989830, 47.984745, 44.001062, 27.994915, 16.031300, 31.989830, 17.002740, 28.006148/
end module CONSTANTS

module MOLECULE_ISOTOP
 type isotop
	integer(4)   :: id_molecule
	character(4) :: name_molecule
 end type isotop
 contains
 function get_id(iso)
	integer(4), intent(in)   :: iso
	type(isotop) :: get_id
	get_id.id_molecule = 0; get_id.name_molecule = ''
	select case(iso)
		case(11,13,14,15,16,17);  get_id.name_molecule = 'H2O '; get_id.id_molecule = 1
		case(21,22,23,24,25,26,27,28,29,20,211,212);  get_id.name_molecule = 'CO2 '; get_id.id_molecule = 2
		case(31,32,33,34,35);  get_id.name_molecule = 'O3  '; get_id.id_molecule = 3
		case(41,42,43,44,45);  get_id.name_molecule = 'N2O '; get_id.id_molecule = 4
		case(51,52,53,54,55,56);  get_id.name_molecule = 'CO  '; get_id.id_molecule = 5
		case(61,62,63,64);  get_id.name_molecule = 'CH4 '; get_id.id_molecule = 6
		case(71,72,73);  get_id.name_molecule = 'O2  '; get_id.id_molecule = 7
		case(131,132,133); get_id.name_molecule = 'OH  '; get_id.id_molecule = 8
		case(221,222); get_id.name_molecule = 'N2  '; get_id.id_molecule = 9
!		case(12);  get_id.name_molecule = 'D2O '; get_id.id_molecule = 1
	end select
 end function get_id
end module MOLECULE_ISOTOP

